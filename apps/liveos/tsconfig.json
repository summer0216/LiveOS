{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/services/chat": [
        "../web/services/chat.ts"
      ],
      "@/services/api": [
        "../web/services/api.ts"
      ],
      "@/types/chat": [
        "../web/types/chat.ts"
      ],
      "@/lib/worldConsequence": [
        "../web/lib/worldConsequence.ts"
      ],
      "@/lib/createClientId": [
        "../web/lib/createClientId.ts"
      ],
      "@/services/property": [
        "../web/services/property.ts"
      ],
      "@/services/profile": [
        "../web/services/profile.ts"
      ],
      "@/services/decisionGeography": [
        "../web/services/decisionGeography.ts"
      ],
      "@/lib/geographicScaleContract": [
        "../web/lib/geographicScaleContract.ts"
      ],
      "@/lib/runtimePresentationContract": [
        "../web/lib/runtimePresentationContract.ts"
      ],
      "@/features/living-map/AMapGround": [
        "../web/features/living-map/AMapGround.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
