#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPOSITORY_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
COMPOSE_FILE="${REPOSITORY_ROOT}/compose.migration-test.yaml"
DATABASE_URL="postgresql://liveos_migration:local_migration_test_only@127.0.0.1:55432/liveos_migration_test"

compose() {
  docker compose -f "${COMPOSE_FILE}" "$@"
}

usage() {
  printf '%s\n' \
    "Usage: scripts/migration-test-db <command>" \
    "" \
    "Commands:" \
    "  up                 Start PostgreSQL 17 and wait until healthy" \
    "  down               Stop it and delete its dedicated test volume" \
    "  status             Show the isolated service status" \
    "  url                Print the local-only test DATABASE_URL" \
    "  psql               Open psql in the migration test database" \
    "  initialize         Execute the current LiveOS schema initialize" \
    "  restore <snapshot> Restore a fresh .sql or pg_dump archive snapshot" \
    "  test               Run the targeted ownership migration tests"
}

command="${1:-}"
case "${command}" in
  up)
    compose up -d --wait postgres
    ;;
  down)
    compose down --volumes --remove-orphans
    ;;
  status)
    compose ps
    ;;
  url)
    printf '%s\n' "${DATABASE_URL}"
    ;;
  psql)
    compose exec postgres psql -U liveos_migration -d liveos_migration_test
    ;;
  initialize)
    (
      cd "${REPOSITORY_ROOT}/apps/api"
      DATABASE_URL="${DATABASE_URL}" UV_CACHE_DIR=/tmp/liveos-migration-uv-cache \
        uv run --python 3.13 python -c \
        'from app.stores.database import Database; import os; Database(os.environ["DATABASE_URL"]).initialize()'
    )
    ;;
  restore)
    snapshot="${2:-}"
    if [[ -z "${snapshot}" || ! -f "${snapshot}" ]]; then
      printf 'Snapshot file not found: %s\n' "${snapshot}" >&2
      exit 2
    fi
    case "${snapshot}" in
      *.sql)
        compose exec -T postgres psql \
          -v ON_ERROR_STOP=1 -U liveos_migration -d liveos_migration_test \
          < "${snapshot}"
        ;;
      *)
        compose exec -T postgres pg_restore \
          --exit-on-error --no-owner --no-privileges \
          -U liveos_migration -d liveos_migration_test \
          < "${snapshot}"
        ;;
    esac
    ;;
  test)
    (
      cd "${REPOSITORY_ROOT}/apps/api"
      TEST_DATABASE_URL="${DATABASE_URL}" \
        UV_CACHE_DIR=/tmp/liveos-migration-uv-cache \
        uv run --python 3.13 pytest -q tests/test_runtime_ownership.py
    )
    ;;
  *)
    usage
    [[ -z "${command}" || "${command}" == "help" ]]
    ;;
esac
